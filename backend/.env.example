# Environment
NODE_ENV=development

# Server
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hazuki_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production_with_a_strong_secret
JWT_EXPIRY=7d

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=2097152

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Logging (optional)
LOG_LEVEL=info
